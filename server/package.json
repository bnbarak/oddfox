{
  "name": "oddfox-crm-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx scripts/migrate-to-firestore.ts",
    "push:sequences": "tsx scripts/push-sequences.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.64.0",
    "@mastra/mcp": "^1.17.3",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "resend": "^6.26.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
