{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oddfox.ai/data/schema/operators.schema.json",
  "title": "Owners, operators and managers",
  "type": "object",
  "required": ["dataset", "records", "gaps"],
  "properties": {
    "dataset": { "const": "operators" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "segment", "roles"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "segment": { "enum": ["container", "dry bulk", "tanker", "gas", "car carrier", "cross-segment"] },
          "hq": { "type": "string" },
          "ownership": { "type": "string" },
          "key_people": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "role"],
              "properties": { "name": { "type": "string" }, "role": { "type": "string" }, "note": { "type": "string" } }
            }
          },
          "fleet_vessels": { "type": "integer" },
          "capacity_teu": { "type": "integer" },
          "market_share_pct": { "type": "number" },
          "market_share_note": { "type": "string" },
          "revenue_usd_bn": { "type": "number" },
          "revenue_year": { "type": "integer" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["beneficial-owner", "registered-owner", "technical-manager", "commercial-manager", "charterer"] },
            "description": "Which layers of ownership-model.json this company occupies. A company can hold several."
          },
          "examples": { "type": "array", "items": { "type": "string" } },
          "fleet_note": { "type": "string" },
          "source_ids": { "$ref": "common.schema.json#/$defs/sourceIds" },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
          "note": { "type": "string" },
          "why_it_matters": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Required and non-empty. A dataset of entities is never complete; saying so in the file is cheaper than discovering it in a pitch."
    }
  }
}
